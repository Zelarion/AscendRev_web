# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# env — no environment file of any kind is committed, including templates.
# The list of variables the enquiry handler needs is documented in DEPLOY.md
# instead, so there is never a file in the tree that a careless copy or rename
# can turn into a real .env.
.env
.env.*
*.env

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# tooling caches
.impeccable/

# Build/scratch artifacts
.next-stale-*/
graphify-out/

# Enquiry storage written by public/api/enquiry.php at runtime.
# Contains submitted personal data - never commit.
ascendrev-enquiries/
