# AscendRev Corp. — Apache configuration for the static site on cPanel.
#
# Copied verbatim into out/ at build time. Nothing here is required for the
# site to ROUTE: Next.js is built with trailingSlash, so every page is a real
# directory with an index.html and Apache's DirectoryIndex finds it unaided.
# If this file is lost or overwritten, the site still works; it just loses
# HTTPS enforcement, caching and the custom 404.

# ---------------------------------------------------------------------------
# HTTPS and public host
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  # One public host. Without this, www served a full duplicate of the site and
  # split ranking signals between two hostnames. www goes straight to the
  # HTTPS bare domain in a single hop, whatever scheme it arrived on.
  RewriteCond %{HTTP_HOST} ^www\.ascend-rev\.ca$ [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge(?:/|$) [NC]
  RewriteRule ^ https://ascend-rev.ca%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^ascend-rev\.ca$ [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge(?:/|$) [NC]
  RewriteRule ^ https://ascend-rev.ca%{REQUEST_URI} [R=301,L]
</IfModule>

# ---------------------------------------------------------------------------
# Public directory URLs behind Render's TLS proxy
# ---------------------------------------------------------------------------
# Apache's mod_dir redirect uses the private connection scheme and port, which
# can expose Render's container port (for example :10000). Render enforces
# public HTTPS, so canonicalize directory URLs directly from the public Host
# header instead of letting mod_dir build a Location header.
# Matches any *.onrender.com host rather than fixed service names: a new or
# renamed service (ascendrev-web became ascendrev-web-1) silently fell outside
# the old list and brought the :10000 redirect back. cPanel hosts never match.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^[a-z0-9-]+\.onrender\.com$ [NC]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI}/ [R=302,L]
</IfModule>

# ---------------------------------------------------------------------------
# 404
# ---------------------------------------------------------------------------
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Caching
# ---------------------------------------------------------------------------
# Next.js fingerprints filenames under /_next/static/, so those are safe to
# cache permanently: a changed file gets a new name. HTML and ordinary files
# in /images or /fonts remain refreshable so replacing a public URL propagates.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 day"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 day"
  ExpiresByType application/javascript   "access plus 1 day"
  ExpiresByType image/svg+xml             "access plus 1 week"
  ExpiresByType image/webp                "access plus 1 week"
  ExpiresByType image/avif                "access plus 1 week"
  ExpiresByType image/png                 "access plus 1 week"
  ExpiresByType image/jpeg                "access plus 1 week"
  ExpiresByType font/woff2                "access plus 1 month"
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/_next/static/" ASCENDREV_FINGERPRINTED=1
</IfModule>

<IfModule mod_headers.c>
  # Only Next's content-hashed build output is immutable. Public URLs can be
  # replaced in place, so cache them briefly and permit background revalidation.
  <FilesMatch "\.(js|mjs|css|woff2?|avif|webp|svg|png|jpe?g|gif|ico|ttf|otf)$">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800" env=!ASCENDREV_FINGERPRINTED
  </FilesMatch>
  <FilesMatch "\.(js|mjs|css|woff2?|avif|webp|svg|png|jpe?g|gif|ico|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable" env=ASCENDREV_FINGERPRINTED
  </FilesMatch>
  <FilesMatch "\.html?$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # ------------------------------------------------------------------------
  # Security headers
  # ------------------------------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # HSTS is deliberately omitted until HTTPS above is enabled and verified.
  # It is cached hard by browsers and is painful to undo if switched on early.
</IfModule>

# ---------------------------------------------------------------------------
# Directory listings
# ---------------------------------------------------------------------------
Options -Indexes
