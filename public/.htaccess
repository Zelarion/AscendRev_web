# AscendRev Corp. — Apache configuration for the static site on cPanel.
#
# Copied verbatim into out/ at build time. Nothing here is required for the
# site to ROUTE: Next.js is built with trailingSlash, so every page is a real
# directory with an index.html and Apache's DirectoryIndex finds it unaided.
# If this file is lost or overwritten, the site still works; it just loses
# HTTPS enforcement, caching and the custom 404.

# ---------------------------------------------------------------------------
# HTTPS and public host
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^(?:www\.)?ascend-rev\.ca$ [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge(?:/|$) [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# ---------------------------------------------------------------------------
# 404
# ---------------------------------------------------------------------------
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Caching
# ---------------------------------------------------------------------------
# Next.js fingerprints filenames under /_next/static/, so those are safe to
# cache permanently: a changed file gets a new name. HTML must NOT be cached
# hard, or visitors keep seeing an old page after we publish an update.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|avif|webp|svg|png|jpg|jpeg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # ------------------------------------------------------------------------
  # Security headers
  # ------------------------------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # HSTS is deliberately omitted until HTTPS above is enabled and verified.
  # It is cached hard by browsers and is painful to undo if switched on early.
</IfModule>

# ---------------------------------------------------------------------------
# Directory listings
# ---------------------------------------------------------------------------
Options -Indexes
